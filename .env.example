# ---- Telegram (আবশ্যক) ----
TELEGRAM_BOT_TOKEN=123456:ABC...
TELEGRAM_CHAT_ID=123456789          # আপনার নিজের Chat ID = Admin

# ---- ডোমেইন ----
YOUR_DOMAINS=safix.tech, mdsafix.tech

# ---- Mini App / Gmail / Worker এর জন্য আপনার সার্ভারের HTTPS ঠিকানা ----
PUBLIC_URL=https://your-app.onrender.com
INBOUND_SECRET=একটা-লম্বা-র‍্যান্ডম-স্ট্রিং   # Cloudflare Worker-এর সাথে একই

# ---- Titan IMAP (ঐচ্ছিক) — mail:password,mail2:password2 ----
TITAN_ACCOUNTS=

# ---- Gmail "Continue with Gmail" (ঐচ্ছিক) ----
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GMAIL_POLL_MS=6000

# ---- অন্যান্য ----
BRAND_NAME=ARIYAN MAIL
OPEN_ACCESS=false          # true দিলে সবাই অনুমোদন ছাড়া ব্যবহার করতে পারবে
DATA_DIR=./data            # Render/Railway-তে Persistent Disk এর পাথ দিন (যেমন /app/data)
RETENTION_DAYS=7
MAX_MESSAGES_PER_USER=150
TZ_NAME=Asia/Dhaka
